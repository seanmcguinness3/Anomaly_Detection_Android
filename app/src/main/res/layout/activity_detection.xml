<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Detection"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="4dp"/>

    <!-- Gait type selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simulate gait type:"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginTop="12dp"/>

    <Spinner
        android:id="@+id/spinnerGaitType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"/>

    <!-- Anomaly status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Waiting…"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/colorNormal"
        android:layout_marginBottom="8dp"/>

    <!-- Score value -->
    <TextView
        android:id="@+id/tvScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Score: —"
        android:textSize="16sp"
        android:textColor="#555555"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <!-- Threshold label -->
    <TextView
        android:id="@+id/tvThreshold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Threshold: —"
        android:textSize="13sp"
        android:textColor="#AAAAAA"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Score meter -->
    <ProgressBar
        android:id="@+id/progressScore"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:max="100"
        android:progress="0"
        android:layout_marginBottom="16dp"/>

    <!-- Scrolling score history chart -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Score history (last 60 windows)"
        android:textSize="12sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="4dp"/>

    <com.gaitdetector.ScoreHistoryView
        android:id="@+id/scoreHistoryView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"/>

</LinearLayout>
